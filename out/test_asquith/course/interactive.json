    "test_asquith.ratio_method": {
      "ext": {},
      "hash": "be3aa822d8e2bf1a",
      "data": {
        "spec": {
          "feasible": true,
          "title": "Анализ отношения водонасыщенности зон",
          "note": "Нажми на часть, чтобы узнать её роль в оценке подвижности углеводородов.",
          "layout": "chain",
          "parts": [
            {
              "label": "Отсутствие перемещения",
              "description": "При равном или большем значении отношения к единице углеводороды не перемещались при вторжении.",
              "claim_id": "test_asquith.ratio_method#c5",
              "rock": null
            },
            {
              "label": "Подвижные углеводороды",
              "description": "Определяются по значению отношения менее 0.7 для песчаников или менее 0.6 для карбонатов.",
              "claim_id": "test_asquith.ratio_method#c6",
              "rock": null
            },
            {
              "label": "Ступенчатый профиль вторжения",
              "description": "Индикатор корректности допущений, когда значения сопоставления примерно равны.",
              "claim_id": "test_asquith.ratio_method#c8",
              "rock": null
            },
            {
              "label": "Слишком слабое или глубокое вторжение",
              "description": "Фиксируется при превышении сопоставляемого значения водонасыщенности из-за слишком низкого отношения сопротивлений.",
              "claim_id": "test_asquith.ratio_method#c9",
              "rock": null
            },
            {
              "label": "Влияние соседних пластов или заниженный Rt",
              "description": "Проявляется при обратном соотношении значений из-за высокой плотности соседних высокоомных пластов.",
              "claim_id": "test_asquith.ratio_method#c10",
              "rock": null
            }
          ]
        },
        "data": {
