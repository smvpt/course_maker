    "test_asquith.saturation_crossplots": {
      "ext": {},
      "hash": "e351c350ff5580b5",
      "data": {
        "spec": {
          "feasible": true,
          "title": "Структура и элементы кроссплотов насыщения Пикетта и Хингла",
          "note": "Нажми на элемент схемы, чтобы узнать его назначение и особенности.",
          "layout": "chain",
          "parts": [
            {
              "label": "Кроссплоты насыщения",
              "description": "Являются графическими решениями уравнения водонасыщенности Арчи и строятся как x-y графики лог-данных для определения водонасыщенности.",
              "claim_id": "test_asquith.saturation_crossplots#c1",
              "rock": null
            },
            {
              "label": "Метод Пикетта",
              "description": "Оценивает водонасыщенность, а истинное сопротивление и пористость откладывает в логарифмических масштабах для определения параметров через наклон и пересечение прямой.",
              "claim_id": "test_asquith.saturation_crossplots#c3",
              "rock": null
            },
