{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glava-kurs/illustration.schema.json",
  "title": "Иллюстрации демо-курса по главе",
  "type": "object",
  "required": ["chapter", "illustrations"],
  "properties": {
    "chapter": {"type": "string"},
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "step_id", "file", "frame_class", "origin", "caption", "alt"],
        "properties": {
          "id": {"type": "string"},
          "step_id": {"type": "string"},
          "node_id": {"type": ["string", "null"]},
          "file": {"type": "string", "description": "путь к файлу (PNG, SVG, JPG, GIF, MP4)"},
          "frame_class": {"enum": ["A", "B", "C", "D"], "description": "A данные, B процессы, C внешний вид, D атмосфера"},
          "origin": {"enum": ["code_from_data", "code_from_model", "photo", "redrawn_from_book", "ai_generated"], "description": "как сделана картинка"},
          "label": {"enum": ["реальные данные", "симуляция", "схема", "иллюстрация ИИ"], "description": "метка на самой картинке"},
          "caption": {"type": "string", "description": "что изображено"},
          "alt": {"type": "string", "description": "альтернативный текст"},
          "source": {"type": ["string", "null"], "description": "источник фото, датасет или «перерисовано по рис. N, стр. M»"},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "description": "утверждения, которые иллюстрация показывает (для A и B)"},
          "prompt": {"type": ["string", "null"], "description": "для ai_generated: промпт генерации"}
        },
        "allOf": [
          {"if": {"properties": {"origin": {"const": "ai_generated"}}}, "then": {"properties": {"frame_class": {"enum": ["C", "D"]}, "label": {"const": "иллюстрация ИИ"}}, "required": ["label", "prompt"]}}
        ]
      }
    }
  }
}
