{% extends "base.html.j2" %}
{% from "_macros.html.j2" import review_tabs %}
{% block title %}Мой прогресс — {{ chapter_title }}{% endblock %}
{% block main %}
<h1>Мой прогресс</h1>
{{ review_tabs("progress") }}
{% if not n_tasks %}
<div class="empty-state">
  <p class="empty-ic" aria-hidden="true">{{ icon("chart-bar") }}</p>
  <p><strong>Заданий в этой главе пока нет, поэтому освоение считать не по чему.</strong></p>
  <p class="muted">Пройденные шаги отмечены на странице пути.</p>
  <p><a class="btn" href="index.html">{{ icon("house") }}<span>К пути по главе</span></a></p>
</div>
{% else %}
<section class="mastery card-box" aria-labelledby="mastery-pct">
  <h2 id="mastery-pct">0% освоено</h2>
  <div class="mbar" id="mastery-bar" role="img" aria-label="Нет данных">
    <span class="seg seg-bad" data-seg-bar="repeat"></span><span class="seg seg-warn" data-seg-bar="reinforce"></span><span class="seg seg-ok" data-seg-bar="mastered"></span>
  </div>
</section>

<div class="tabs" role="group" aria-label="Статус шагов">
  <button type="button" data-tab="new" aria-pressed="true" title="Не начато: ответов ещё нет">Не начато <span class="tab-n" data-tab-n="new">0</span></button>
  <button type="button" data-tab="repeat" aria-pressed="false" title="Нужно повторить: есть неверные ответы" aria-label="Нужно повторить">Повторить <span class="tab-n" data-tab-n="repeat">0</span></button>
  <button type="button" data-tab="reinforce" aria-pressed="false" title="Закрепить: часть заданий решена верно">Закрепить <span class="tab-n" data-tab-n="reinforce">0</span></button>
  <button type="button" data-tab="mastered" aria-pressed="false" title="Освоено: все задания решены верно">Освоено <span class="tab-n" data-tab-n="mastered">0</span></button>
</div>
<ul id="progress-list" class="progress-list"></ul>
<p id="progress-empty" class="empty" hidden>В этой вкладке пока пусто.</p>
<p class="muted legend-segs">Значки в полосках: <span class="gl gl-ok" aria-hidden="true"></span> верно, <span class="gl gl-bad" aria-hidden="true"></span> неверно, <span class="gl gl-none" aria-hidden="true"></span> не решено.</p>
{% endif %}
{% endblock %}
