<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<script>
/* тема ДО отрисовки (первым в <head>): иначе мелькнёт светлая; localStorage на file:// может быть недоступен */
(function () { try { var t = JSON.parse(localStorage.getItem("course:theme")); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {} })();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ chapter_title }}{% endblock %}</title>
<link rel="icon" type="image/svg+xml" href="assets/brand/favicon.svg">
<link rel="stylesheet" href="assets/tokens.css">
<link rel="stylesheet" href="assets/course.css">
{% block head %}{% endblock %}
</head>
<body data-ch="{{ ch }}" data-page="{{ page }}">
<a class="skip" href="#content">К содержанию</a>
<header class="top">
  <a class="brand" href="{% if hub %}../../index.html{% else %}index.html{% endif %}" title="KERN{% if hub %} — все курсы{% else %} — к пути по главе{% endif %}">{{ brand("symbol-mono") }}</a>
  <nav class="crumbs-top" aria-label="Вы здесь">
    <ol>
      {% if hub %}<li><a href="../../index.html">Курсы</a></li><li class="crumb-sep" aria-hidden="true">/</li>{% endif %}
      <li class="crumb-cur"><a class="brand-title" href="index.html"{% if page == "index" %} aria-current="page"{% endif %}>{{ chapter_title }}</a></li>
    </ol>
  </nav>
  <div class="search" role="search">
    <label class="sr" for="search-input">Поиск по курсу</label>
    <span class="search-ic" aria-hidden="true">{{ icon("magnifying-glass") }}</span>
    <input id="search-input" type="search" role="combobox" aria-autocomplete="list" placeholder="Найти термин или тему" autocomplete="off" spellcheck="false" aria-controls="search-results" aria-expanded="false">
    <kbd class="search-key" aria-hidden="true">/</kbd>
    <div id="search-results" class="search-results" role="listbox" aria-label="Результаты поиска" hidden></div>
  </div>
  <button type="button" id="open-search" class="tool search-toggle" aria-label="Поиск" title="Поиск (клавиша /)" aria-expanded="false">{{ icon("magnifying-glass") }}</button>
  <button type="button" id="open-menu" class="tool menu-btn" data-open-menu aria-haspopup="dialog" aria-controls="menu" title="Меню">{{ icon("list") }}<span class="menu-label">Меню</span></button>
</header>
<main id="content" tabindex="-1" class="{% block mainclass %}{% endblock %}">
{% block main %}{% endblock %}
</main>
{% block after_main %}{% endblock %}

<dialog id="menu" class="menu" aria-labelledby="menu-h">
  <form method="dialog" class="dlg-close"><button type="submit" class="tool" aria-label="Закрыть меню">{{ icon("x") }}</button></form>
  <h2 id="menu-h">Меню</h2>
  <nav aria-label="Разделы курса">
    <h3 class="menu-group">Курс</h3>
    <ul class="menu-list">
      {% for key, href, text, ic, shown in (("index", "index.html", "Путь", "house", True), ("tasks", "tasks.html", "Все задания", "list-checks", n_tasks),
                                            ("glossary", "glossary.html", "Словарь главы", "book-bookmark", has_glossary), ("summary", "summary.html", "Конспект", "article", True),
                                            ("map", "map.html", "Карта связей", "tree-structure", True), ("it", "it.html", "Что ломается в данных", "cpu", has_it)) %}
      {% if shown %}<li><a href="{{ href }}"{% if page == key or (key == "index" and page == "step") %} aria-current="page"{% endif %}>{{ icon(ic) }}<span>{{ text }}</span></a></li>{% endif %}
      {% endfor %}
      {% if has_errata %}<li><a href="errata.html"{% if page == "errata" %} aria-current="page"{% endif %}>{{ icon("warning") }}<span>Лист опечаток</span></a></li>{% endif %}
    </ul>
    <h3 class="menu-group">Повторение</h3>
    <ul class="menu-list">
      {% if n_tasks %}<li><a href="progress.html"{% if page == "progress" %} aria-current="page"{% endif %} id="solved-link" title="Решено заданий: 0 из {{ n_tasks }}">{{ icon("chart-bar") }}<span>Прогресс</span><span class="menu-count" id="solved-count">0</span><span class="sr" id="solved-sr"> из {{ n_tasks }} заданий решено</span></a></li>
      <li><a href="mistakes.html"{% if page == "mistakes" %} aria-current="page"{% endif %}>{{ icon("arrow-counter-clockwise") }}<span>Ошибки</span></a></li>{% endif %}
      <li><a href="cards.html"{% if page == "cards" %} aria-current="page"{% endif %}>{{ icon("cards") }}<span>Карточки</span></a></li>
    </ul>
  </nav>
  <h3 class="menu-group">Настройки</h3>
  <div class="menu-settings">
    <p id="theme-label" class="menu-label-line">Тема</p>
    <div class="theme-set" role="group" aria-labelledby="theme-label">
      <button type="button" class="btn-small" data-theme-set="system" aria-pressed="true">{{ icon("desktop") }}<span>Системная</span></button>
      <button type="button" class="btn-small" data-theme-set="light" aria-pressed="false">{{ icon("sun") }}<span>Светлая</span></button>
      <button type="button" class="btn-small" data-theme-set="dark" aria-pressed="false">{{ icon("moon") }}<span>Тёмная</span></button>
    </div>
    <label class="switch"><input type="checkbox" role="switch" data-by-switch id="setting-by" aria-describedby="by-help"><span class="switch-track" aria-hidden="true"></span><span class="switch-text">Показать, что из книги, а что пересказ</span></label>
    <p id="by-help" class="muted menu-help">Над текстом шага появится легенда, у абзацев — метки «из книги» и «пересказ»; гипотезы помечены всегда.</p>
  </div>
</dialog>
{{ sprite() }}
{% block scripts %}{% endblock %}
<script src="assets/course-data.js"></script>
<script src="assets/course.js"></script>
</body>
</html>
