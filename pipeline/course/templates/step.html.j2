{% extends "base.html.j2" %}
{% from "_macros.html.j2" import badge, path_list %}
{% block title %}{{ v.title }} — {{ chapter_title }}{% endblock %}
{% block mainclass %}with-side{% endblock %}
{% block head %}{% if v.formulas %}<link rel="stylesheet" href="assets/katex/katex.min.css">
<noscript><style>.formula[data-katex] .tex:not(.rendered) { visibility: visible; }</style></noscript>{% endif %}{% endblock %}
{% block scripts %}{% if v.formulas %}<script src="assets/katex/katex.min.js"></script>{% endif %}{% endblock %}

{# «стр. N» — компактный чип в конце абзаца, в той же строке #}
{% macro chips(pages) -%}
{% for p in pages %}<button type="button" title="Открыть страницу книги" class="pg" data-page="{{ p }}">стр. {{ p }}</button>{% if not loop.last %} {% endif %}{% endfor %}
{%- endmacro %}

{% macro claim_chip(c) -%}
<button type="button" title="Открыть страницу книги" class="pg" data-claim="{{ c.id }}">стр. {{ c.page_pdf }}</button>
{%- endmacro %}

{# абзацы, написанные по узлу (step_text.json): «стр. N» — страницы утверждений, на которые ссылается абзац #}
{% macro gen(items) -%}
{% for p in items %}
<div class="para{% if p.limit %} limit{% endif %}" id="{{ p.id }}" data-claims="{{ p.claims }}"><p data-by="{{ p.by }}">{{ p.html }} {{ badge(p.by) }} {{ chips(p.pages) }}</p></div><!--/para-->
{% endfor %}
{%- endmacro %}

{# запасной вариант без step_text.json: абзац из поля слоя, страницы — все страницы узла #}
{% macro field(f, extra="") -%}
{% if has_text(f) %}
<div class="para"><p data-by="{{ by_of(f) }}">{{ extra }}{{ f.text }} {{ badge(by_of(f)) }} {{ chips(v.node.pages) }}</p></div><!--/para-->
{% endif %}
{%- endmacro %}

{% macro claim_para(c) -%}
<div class="para" id="{{ c.id | replace('#', '--') }}">
  <p data-by="{{ by_of(c) }}">{{ c.text }} {{ badge(by_of(c)) }}{% if c.kind != "observation" %} <span class="kind">{{ {"inference": "вывод", "assumption": "допущение"}[c.kind] }}</span>{% endif %} {{ claim_chip(c) }}</p>
  <blockquote class="quote" data-by="author">{{ icon("quotes") }}<span>{{ c.quote }}</span><cite>Автор, стр. {{ c.page_pdf }}</cite></blockquote>
</div><!--/para-->
{%- endmacro %}

{# сворачиваемый длинный блок #}
{% macro fold(what) -%}
<details class="fold">
  <summary><span class="when-closed">Показать {{ icon("caret-down") }}</span><span class="when-open">Скрыть {{ icon("caret-down") }}</span><span class="sr"> — {{ what }}</span></summary>
  {{ caller() }}
</details>
{%- endmacro %}

{% macro answer_row(t, o, kind) -%}
<label class="opt"><input type="{{ kind }}" name="opt-{{ t.id }}" value="{{ o.id }}"><span class="opt-text">{{ o.text }}</span><span class="opt-mark" aria-hidden="true">{{ icon("check") }}</span></label>
{%- endmacro %}


{% block main %}
{% set n = v.node %}
<aside class="path-side" aria-label="Путь по главе">
  <h2 class="side-title">Путь по главе</h2>
  {{ path_list(steps, n.id) }}
</aside>

<article class="step" data-node="{{ n.id }}">
<header class="step-head">
  <p class="kicker">Шаг {{ idx + 1 }} из {{ steps | length }} · ≈ {{ v.minutes }} мин{% if v.pages_label %} · {{ v.pages_label }}{% endif %}{% if n.threshold %} · <span class="key-concept" title="Ключевое понятие: без него следующие шаги будут непонятны" tabindex="0">{{ icon("star") }}<span class="sr">ключевое понятие</span></span>{% endif %}</p>
  <h1>{{ v.title }}</h1>
  {% if has_text(n.layers.topic) %}<p class="topic subtitle" data-by="{{ by_of(n.layers.topic) }}">{{ n.layers.topic.text }}</p>{% endif %}
  {% if v.prereqs %}
  <p class="prereq"><span class="prereq-label">Опирается на</span> {% for p in v.prereqs %}{% if p in titles %}<a class="prereq-chip" href="step-{{ p }}.html">{{ titles[p] }}</a>{% else %}<span class="prereq-chip">{{ p }}</span>{% endif %} {% endfor %}</p>
  {% endif %}
  <div class="bar slim step-bar-inline" aria-hidden="true" hidden><span id="step-bar"></span></div>
  <p id="step-progress-text" class="sr" aria-live="polite">Прогресс шага: 0 из {{ v.check_items }}</p>
</header>
<div class="by-legend" role="note">
  <p class="by-legend-row"><span class="sw sw-author" aria-hidden="true"></span>из книги (слова автора) <span class="sw-sep" aria-hidden="true">·</span> <span class="sw sw-model" aria-hidden="true"></span>пересказ ИИ <span class="sw-sep" aria-hidden="true">·</span> <span class="sw sw-hyp" aria-hidden="true"></span>гипотеза</p>
  <p class="by-legend-note">Пересказ проверен по странице книги — нажмите «стр. N».</p>
</div>
<div class="source-compact" aria-label="Источник шага">
  <span class="side-pages">{{ icon("book-open") }}{{ v.pages_label or "Страницы не указаны" }}</span>
  {% if n.claims %}<button type="button" class="pg pg-btn" data-claim="{{ (v.text_claims[0] if v.text_claims else n.claims[0]).id }}">{{ icon("magnifying-glass") }}Открыть страницу книги</button>{% endif %}
  <label class="switch"><input type="checkbox" role="switch" data-by-switch><span class="switch-track" aria-hidden="true"></span><span class="switch-text">Показать, что из книги, а что пересказ</span></label>
</div>

{% if v.guess %}
{% set g = v.guess %}
<section id="guess" class="guess" aria-labelledby="guess-h" data-truth="{{ 'true' if g.truth else 'false' }}">
  <h2 id="guess-h">{{ icon("lightbulb") }}Сначала угадай</h2>
  <p class="guess-q">«{{ g.statement }}» {{ badge("model") }}</p>
  <p class="guess-ask" id="guess-ask">Как думаешь: это верно?</p>
  <div class="guess-btns" role="group" aria-labelledby="guess-ask">
    <button type="button" class="btn" data-answer="true">Верно</button>
    <button type="button" class="btn" data-answer="false">Неверно</button>
    <button type="button" class="btn-small" data-action="skip">Пропустить вопрос</button>
  </div>
  <div class="guess-result" hidden tabindex="-1" role="status">
    <p class="guess-verdict"><span class="gv-ok">{{ icon("check-circle") }}Совпало</span><span class="gv-bad">{{ icon("x-circle") }}Не совпало</span>:
      <span class="gv-true">на самом деле это верно.</span><span class="gv-false">на самом деле это неверно.</span></p>
    <p class="guess-expl">{{ g.explanation }} {{ chips(g.pages) }}</p>
  </div>
</section>
{% endif %}

<div id="step-body">
{% if v.show["b-main"] or v.show["b-why"] or v.show["b-how"] or v.show["b-formulas"] or v.show["b-examples"] or v.show["b-illus"] or v.show["b-interactive"] or v.show["b-media"] %}
<section class="tier " id="tier-understand" aria-labelledby="tier-understand-h">
<h2 class="tier-h" id="tier-understand-h">{{ icon("graduation-cap") }}Понять</h2>
{% if v.show["b-main"] %}
<section id="b-main" class="block block-main"><h3 class="block-h">{{ icon("target") }}Суть</h3>{% if v.paras %}{{ gen(v.paras.get("main", [])) }}{% else %}{{ field(n.layers.main) }}{% endif %}{% if idx == 0 %}
  <p class="hint" id="hint-pages" role="note">{{ icon("info") }}<span>Нажмите «стр. {{ v.hint_page }}» — откроется страница книги. Наведите на термин — увидите определение.</span><button type="button" class="tool" data-hint-close aria-label="Закрыть подсказку">{{ icon("x") }}</button></p>
  {% endif %}</section>
{% endif %}

{% if v.show["b-why"] %}
<section id="b-why" class="block"><h3 class="block-h">{{ icon("question") }}Зачем этот шаг</h3>{% if v.paras %}{{ gen(v.paras.get("why", [])) }}{% else %}{{ field(n.why_here) }}{% endif %}</section>
{% endif %}

{% if v.show["b-how"] %}
<section id="b-how" class="block"><h3 class="block-h">{{ icon("gear") }}Как это работает</h3>
  {% if v.paras %}
  {{ gen(v.paras.get("how", [])) }}
  {% else %}
  {{ field(n.layers.mechanism) }}
  {% for c in v.text_claims %}{{ claim_para(c) }}{% endfor %}
  {% endif %}
</section>
{% endif %}

{% if v.show["b-formulas"] %}
<section id="b-formulas" class="block"><h3 class="block-h">{{ icon("function") }}Формулы</h3>
  {% for c in v.formulas %}
  <div class="para" id="{{ c.id | replace('#', '--') }}">
    <div class="formula"{% if v.formulas %} data-katex{% endif %}><span class="formula-label">формула</span><code class="tex" data-tex="{{ c.quote }}">{{ c.quote }}</code></div>
    <p data-by="{{ by_of(c) }}">{{ c.text }} {{ badge(by_of(c)) }} {{ claim_chip(c) }}</p>
  </div><!--/para-->
  {% endfor %}
</section>
{% endif %}

{% if v.show["b-examples"] %}
<section id="b-examples" class="block"><h3 class="block-h">{{ icon("chalkboard-simple") }}Разбор примеров из главы</h3>
  {% for w in n.worked_examples %}
  <div class="para example">
    <p data-by="{{ by_of(w) }}"><strong>Условие.</strong> {{ w.condition }}</p>
    {% if w.steps %}<ol class="steps" data-by="{{ by_of(w) }}">{% for s in w.steps %}<li>{{ s }}</li>{% endfor %}</ol>{% endif %}
    <p data-by="{{ by_of(w) }}"><strong>Итог.</strong> {{ w.result }} {{ badge(by_of(w)) }} {{ chips([w.page_pdf]) }}</p>
    {% if w.figure %}<p class="fig-ref">Рисунок в книге: {{ w.figure }}</p>{% endif %}
  </div><!--/para-->
  {% endfor %}
</section>
{% endif %}

{% if v.show["b-illus"] %}
<section id="b-illus" class="block"><h3 class="block-h">{{ icon("image") }}Иллюстрации</h3>
  {% for it in v.illus %}
  <figure class="illus">
    <img src="{{ it.src }}" alt="{{ it.il.alt }}" loading="lazy">
    <figcaption>{{ it.il.caption }}{% if it.il.label %} · <span class="prov">{{ it.il.label }}</span>{% endif %}{% if it.il.source %} · {{ it.il.source }}{% endif %}</figcaption>
  </figure>
  {% endfor %}
</section>
{% endif %}

{% if v.show["b-interactive"] %}
{% set it = v.inter %}
{% set sl = it.data.slider %}
{% if it.scheme %}
<section id="b-interactive" class="block"><h3 class="block-h">{{ icon("sliders-horizontal") }}Интерактив <span class="prov-chip">схема</span></h3>
  <p class="inter-title"><strong>{{ it.data.title }}</strong></p>
  <p class="muted">{{ it.data.note }} {{ badge("model") }}</p>
  <div class="scheme" data-template="scheme" data-layout="{{ it.data.layout }}">
    <div class="scheme-tools" role="group" aria-label="Режим схемы">
      <button type="button" class="btn-small" data-mode="explore" aria-pressed="true">Исследовать</button>
      <button type="button" class="btn-small" data-mode="quiz" aria-pressed="false">Проверь себя</button>
    </div>
    <ol class="scheme-parts" aria-label="Части схемы">
      {% for p in it.parts %}<li><button type="button" class="scheme-part" data-i="{{ loop.index0 }}"{% if p.color %} style="--part-bg: {{ p.color }}; --part-fg: {{ p.on }}"{% endif %}><span class="scheme-n">{{ loop.index }}</span><span class="scheme-label">{{ p.label }}</span></button></li>{% endfor %}
    </ol>
    <div class="scheme-detail" id="scheme-detail" aria-live="polite" tabindex="-1"><p class="muted">Выбери часть схемы: клик, Enter или пробел.</p></div>
  </div>
  <p class="muted">Схема собрана из утверждений узла, а не из измерений: у каждой части есть страница книги.</p>
  <script type="application/json" id="inter-data">{{ it.json }}</script>
</section>
{% else %}
<section id="b-interactive" class="block"><h3 class="block-h">{{ icon("sliders-horizontal") }}Интерактив <span class="prov-chip">симуляция</span></h3>
  <p class="inter-title"><strong>{{ it.data.title }}</strong></p>
  <p class="muted">{{ it.data.note }} {{ badge("model") }}</p>
  <div class="inter" data-template="{{ it.data.template }}">
    <div class="inter-controls">
      <label for="inter-slider">{{ sl.label }}{% if sl.unit %}, {{ sl.unit }}{% endif %}</label>
      <input type="range" id="inter-slider" min="0" max="{{ it.steps - 1 }}" step="1" value="0">
      <output id="inter-readout" for="inter-slider">Двигай слайдер: стрелки на клавиатуре или палец.</output>
    </div>
    <svg class="inter-chart" id="inter-chart" viewBox="0 0 400 380" role="img"
         aria-label="График «{{ it.data.title }}». Слайдер меняет значение; те же числа есть в таблице под графиком."></svg>
  </div>
  <p class="muted">Значения рассчитаны кодом по формуле главы, а не измерены. {{ chips([it.data.page]) }}</p>
  {% call fold("таблица значений") %}
  <div class="table-wrap" tabindex="0" role="region" aria-label="Таблица значений интерактива">
    <table><thead><tr>{% for h in it.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
    <tbody>{% for r in it.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
  </div>
  {% endcall %}
  <script type="application/json" id="inter-data">{{ it.json }}</script>
</section>
{% endif %}
{% endif %}

{% if v.show["b-media"] %}
<section id="b-media" class="block"><h3 class="block-h">{{ icon("video-camera") }}Ролик</h3>
  {% if v.media.kind == "video" %}
  <video controls preload="metadata" src="{{ v.media.src }}">
    {% if v.media.cues %}<track kind="subtitles" srclang="ru" label="Русские субтитры" data-cues="cues-main" default>{% endif %}
  </video>
  {% if v.media.cues %}<script type="application/json" id="cues-main">{{ v.media.cues }}</script>{% endif %}
  {% if v.media.passport %}<p class="muted">Как сделан ролик: <a href="{{ v.media.passport }}">паспорт ролика</a>.</p>{% endif %}
  {% if v.media.more %}
  <p class="more-title"><strong>Подробнее: длинный разбор</strong></p>
  {% call fold("длинный разбор") %}
  <video controls preload="none" src="{{ v.media.more.src }}">
    {% if v.media.more.cues %}<track kind="subtitles" srclang="ru" label="Русские субтитры" data-cues="cues-more" default>{% endif %}
  </video>
  {% if v.media.more.cues %}<script type="application/json" id="cues-more">{{ v.media.more.cues }}</script>{% endif %}
  {% if v.media.more.passport %}<p class="muted">Как сделан ролик: <a href="{{ v.media.more.passport }}">паспорт ролика</a>.</p>{% endif %}
  {% endcall %}
  {% endif %}
  {% else %}
  <p class="muted">Ролик по этому шагу не собран{% if v.media.passport %}; спецификация сцены — в <a href="{{ v.media.passport }}">паспорте ролика</a>{% endif %}.</p>
  {% endif %}
</section>
{% endif %}

{# Задания: разметка заложена, проверка ответов подключается в задаче 3 #}

</section>
{% endif %}
{% if v.show["b-data"] or v.show["b-decision"] or v.show["b-analogy"] or v.show["b-practice"] or v.show["b-misconception"] %}
<section class="tier " id="tier-data" aria-labelledby="tier-data-h">
<h2 class="tier-h" id="tier-data-h">{{ icon("database") }}В данных</h2>
{% if v.show["b-data"] %}
<section id="b-data" class="block"><h3 class="block-h">{{ icon("chart-line") }}Что это значит для данных</h3>
  {% if v.paras %}{{ gen(v.paras.get("data", [])) }}{% else %}
  {{ field(n.data_meaning.from_chapter) }}
  {{ field(n.data_meaning.breaks, "Где ломается: ") }}
  {% for h in v.hypotheses %}{{ field(h) }}{% endfor %}
  {% endif %}
</section>
{% endif %}

{% if v.show["b-decision"] %}
{% set d = n.decision_on_data %}
<section id="b-decision" class="block"><h3 class="block-h">{{ icon("scales") }}Решение на данных</h3>
  {% if v.paras %}{{ gen(v.paras.get("decision", [])) }}{% endif %}
  <div class="para decision">
    <div class="sig-flow" data-by="{{ by_of(d) }}" data-stepper>
      <div class="sig"><h3>Сигнал</h3><ul>{% for f in d.features %}<li>{{ f }}</li>{% endfor %}</ul></div>
      <div class="arrow" aria-hidden="true">{{ icon("arrow-right") }}</div>
      <div class="rule"><h3>Правило</h3><p>{{ d.rule }}</p></div>
      <div class="arrow" aria-hidden="true">{{ icon("arrow-right") }}</div>
      <div class="concl"><h3>Вывод</h3><p>{{ d.conclusion }}</p></div>
    </div>
    <p class="stepper-ctl" hidden>
      <span class="stepper-text" aria-live="polite">Шаг 1 из 3: признаки</span>
      <button type="button" class="btn-small" data-stepper-next>Дальше: правило</button>
      <button type="button" class="btn-small" data-stepper-all>Показать всё</button>
    </p>
    {% if d.counterexample %}<p class="counter" data-by="{{ by_of(d) }}"><strong>Контрпример.</strong> {{ d.counterexample }}</p>{% endif %}
    <p class="src-line">{{ badge(by_of(d)) }}{% if not v.paras %} {{ chips(n.pages) }}{% endif %}</p>
  </div><!--/para-->
</section>
{% endif %}

{% if v.show["b-analogy"] %}
<section id="b-analogy" class="block"><h3 class="block-h">{{ icon("arrows-left-right") }}Аналогия</h3>
  {% if v.paras %}{{ gen(v.paras.get("analogy", [])) }}{% else %}
  <div class="para"><p data-by="{{ by_of(n.it_analogy) }}">{{ n.it_analogy.text }} {{ badge(by_of(n.it_analogy)) }}{% if not n.it_analogy.breaks_where.strip() %} {{ chips(n.pages) }}{% endif %}</p>
  {% if n.it_analogy.breaks_where.strip() %}<p class="limit" data-by="{{ by_of(n.it_analogy) }}"><strong>Где перестаёт работать:</strong> {{ n.it_analogy.breaks_where }} {{ chips(n.pages) }}</p>{% endif %}</div><!--/para-->
  {% endif %}
</section>
{% endif %}

{% if v.show["b-practice"] %}
<section id="b-practice" class="block"><h3 class="block-h">{{ icon("wrench") }}Как делает специалист</h3>
  {% if v.paras %}{{ gen(v.paras.get("practice", [])) }}{% else %}
  {{ field(n.layers.practice) }}
  {% if n.now_practice %}{{ field(n.now_practice, "Как сейчас: ") }}{% endif %}
  {% endif %}
</section>
{% endif %}

{% if v.show["b-misconception"] %}
<section id="b-misconception" class="block block-warn"><h3 class="block-h">{{ icon("warning") }}Частая ошибка</h3>
  {% if v.paras %}{{ gen(v.paras.get("misconception", [])) }}{% else %}{{ field(n.misconception) }}{% endif %}
</section>
{% endif %}

</section>
{% endif %}
{% if v.show["b-quiz"] or v.show["b-check"] %}
<section class="tier " id="tier-check" aria-labelledby="tier-check-h">
<h2 class="tier-h" id="tier-check-h">{{ icon("seal-check") }}Проверить себя</h2>
{% if v.show["b-quiz"] %}
<section id="b-quiz" class="block"><h3 class="block-h">{{ icon("list-checks") }}Задания</h3>
  <div class="task-row" role="group" aria-label="Задания шага">
    {% for it in v.tasks %}<a class="tnum" href="#task-{{ it.t.id }}" data-task-chip="{{ it.t.id }}" data-state="none" aria-label="Задание {{ it.i }}: не решено">{{ it.i }}</a>{% endfor %}
  </div>
  {% for it in v.tasks %}
  {% set t = it.t %}
  <article class="task" id="task-{{ t.id }}" data-task="{{ t.id }}" data-type="{{ t.type }}" data-claim="{{ t.claim_ids[0] }}">
    <h3>Задание {{ it.i }}{% if t.kind %} <span class="kind">{{ {"recall": "узнавание", "understanding": "понимание", "transfer": "перенос", "data": "на данных"}[t.kind] }}</span>{% endif %}</h3>
    {% if t.type == "gap" %}
    <p class="prompt">{% for kind, val in it.parts %}{% if kind == "text" %}{{ val }}{% else %}<input type="text" class="gap" data-gap="{{ val }}" aria-label="Пропуск {{ val }}" autocomplete="off">{% endif %}{% endfor %}</p>
    {% else %}
    <p class="prompt">{{ t.prompt }}</p>
    {% endif %}
    {% if t.type == "single" %}
    <div class="opts" role="radiogroup" aria-label="Варианты ответа">{% for o in t.options %}{{ answer_row(t, o, "radio") }}{% endfor %}</div>
    {% elif t.type == "multiple" %}
    <div class="opts" role="group" aria-label="Варианты ответа, можно выбрать несколько">{% for o in t.options %}{{ answer_row(t, o, "checkbox") }}{% endfor %}</div>
    {% elif t.type == "order" %}
    <ol class="order" aria-label="Расставь по порядку">
      {% for o in t.options %}
      <li class="order-item" data-id="{{ o.id }}"><span class="drag-handle" aria-hidden="true" title="Перетащи">{{ icon("dots-six-vertical") }}</span><span class="opt-text">{{ o.text }}</span>
        <span class="order-btns"><button type="button" class="tool" data-move="up" aria-label="Выше: {{ o.text }}">{{ icon("caret-down") }}</button><button type="button" class="tool" data-move="down" aria-label="Ниже: {{ o.text }}">{{ icon("caret-down") }}</button></span></li>
      {% endfor %}
    </ol>
    {% elif t.type == "calc" %}
    <p class="calc"><input type="number" step="any" inputmode="decimal" class="calc-input" aria-label="Ответ{% if t.unit %}, {{ t.unit }}{% endif %}">{% if t.unit %} <span class="muted">{{ t.unit }}</span>{% endif %}</p>
    {% endif %}
    <p class="task-actions"><button type="button" class="btn" data-action="check">Проверить</button></p>
    <div class="task-msg" role="status" aria-live="polite"></div>
    <div class="feedback" hidden tabindex="-1">
      <div class="fb-status" role="status"><span class="fb-ok">{{ icon("check-circle") }}Верно</span><span class="fb-bad">{{ icon("x-circle") }}Неверно</span></div>
      <p><strong>Правильный ответ:</strong> {{ it.answer }}</p>
      <p class="fb-expl">{{ t.explanation }}</p>
      <p class="fb-btns"><button type="button" class="btn-small" data-action="reread" data-claim="{{ t.claim_ids[0] }}">{{ icon("book-open") }}<span>Перечитать</span></button><button type="button" class="btn-small" data-action="understood" aria-pressed="false">{{ icon("check") }}<span>Я понял</span></button><button type="button" class="btn-small" data-action="again">{{ icon("arrow-counter-clockwise") }}<span>Ещё раз</span></button></p>
    </div>
  </article>
  {% endfor %}
</section>
{% endif %}

<section id="b-check" class="block check"><h3 class="block-h">{{ icon("check-square") }}Чек-лист шага</h3>
  <ul class="checklist">
    <li><label class="check-item"><input type="checkbox" data-check="read"><span>Прочитано</span></label></li>
    {% if v.show["b-media"] and v.media.kind == "video" %}
    <li><label class="check-item"><input type="checkbox" data-check="video"><span>Ролик посмотрен</span></label></li>
    {% endif %}
    {% if v.show["b-quiz"] %}
    <li><label class="check-item"><input type="checkbox" data-check="tasks" disabled><span>Задания решены: <span id="tasks-progress">0 из {{ v.tasks | length }}</span></span></label></li>
    {% endif %}
  </ul>
  <div class="done-banner" id="done-banner" hidden>
    <p class="done-text" role="status">{{ icon("check-circle") }}<span>Шаг пройден</span></p>
    {% if next %}<a class="btn" href="step-{{ next.id }}.html">Дальше<span class="sr">: {{ titles[next.id] }}</span>{{ icon("arrow-right") }}</a>
    {% else %}<a class="btn" href="cards.html">Дальше: карточки{{ icon("arrow-right") }}</a>{% endif %}
  </div>
</section>

</section>
{% endif %}
{% if v.show["b-nuances"] or v.show["b-quotes"] or v.show["b-tables"] or v.show["b-terms"] or v.show["b-deeper"] or v.show["b-tasks"] or v.show["b-source"] %}
<section class="tier tier-deep" id="tier-deep" aria-labelledby="tier-deep-h">
<h2 class="tier-h" id="tier-deep-h">{{ icon("caret-double-down") }}Глубже</h2>
{% if v.show["b-nuances"] %}
<section id="b-nuances" class="block"><h3 class="block-h">{{ icon("magnifying-glass") }}Нюансы</h3>
  {% call fold("нюансы") %}{% if v.paras %}{{ gen(v.paras.get("nuances", [])) }}{% else %}{{ field(n.layers.nuances) }}{% endif %}{% endcall %}
</section>
{% endif %}

{% if v.show["b-quotes"] %}
<section id="b-quotes" class="block"><h3 class="block-h">{{ icon("quotes") }}Цитаты автора</h3>
  {% call fold("цитаты автора") %}{% for c in v.text_claims %}{{ claim_para(c) }}{% endfor %}{% endcall %}
</section>
{% endif %}

{% if v.show["b-tables"] %}
<section id="b-tables" class="block"><h3 class="block-h">{{ icon("table") }}Таблицы книги</h3>
  {% call fold("таблицы книги") %}
  {% for t in v.tables %}
  <div class="para" id="{{ t.claim.id | replace('#', '--') }}">
    <p data-by="{{ by_of(t.claim) }}">{{ t.claim.text }} {{ badge(by_of(t.claim)) }} {{ claim_chip(t.claim) }}</p>
    {% if t.rows %}
    <div class="table-wrap" tabindex="0" role="region" aria-label="Таблица книги, стр. {{ t.claim.page_pdf }}">
      <table data-by="author">
        <thead><tr>{% for h in t.rows[0] %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>{% for r in t.rows[1:] %}<tr>{% for x in r %}<td>{{ x }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table>
    </div>
    {% else %}
    <pre class="table-raw" data-by="author" tabindex="0">{{ t.claim.quote }}</pre>
    {% endif %}
  </div><!--/para-->
  {% endfor %}
  {% endcall %}
</section>
{% endif %}

{% if v.show["b-terms"] %}
<section id="b-terms" class="block"><h3 class="block-h">{{ icon("book-bookmark") }}Новые понятия</h3>
  {% call fold("новые понятия") %}
  {% if n.terms_introduced %}<ul class="terms">{% for t in n.terms_introduced %}<li><dfn>{{ t }}</dfn></li>{% endfor %}</ul>{% endif %}
  {% if n.terms_used %}<p class="muted">Используются: {{ n.terms_used | join(", ") }}</p>{% endif %}
  <p><a href="glossary.html">Весь словарь главы</a></p>
  {% endcall %}
</section>
{% endif %}

{% if v.show["b-deeper"] %}
<section id="b-deeper" class="block"><h3 class="block-h">{{ icon("stack") }}Глубже</h3>
  {% call fold("глубже") %}{% if v.paras %}{{ gen(v.paras.get("deeper", [])) }}{% else %}{% for d in v.deeper %}{{ field(d) }}{% endfor %}{% endif %}{% endcall %}
</section>
{% endif %}

{% if v.show["b-tasks"] %}
<section id="b-tasks" class="block"><h3 class="block-h">{{ icon("pencil-simple-line") }}Задачи из книги</h3>
  {% call fold("задачи из книги") %}
  {% for t in n.book_tasks %}
  <div class="para"><p data-by="{{ by_of(t) }}"><strong>Задача {{ t.number }}.</strong> {{ t.text }} {{ badge(by_of(t)) }} {{ chips([t.page_pdf]) }}</p>
  {% if t.figure %}<p class="fig-ref">Нужен рисунок: {{ t.figure }}</p>{% endif %}</div><!--/para-->
  {% endfor %}
  {% endcall %}
</section>
{% endif %}

<section id="b-source" class="block"><h3 class="block-h">{{ icon("book-open") }}Источник</h3>
  {% call fold("источник") %}
  <p class="muted">Каждое утверждение шага — со страницей PDF и дословной цитатой. Нажми «стр. N», чтобы сверить по книге.</p>
  <ol class="sources">
  {% for c in n.claims %}
    <li>{{ claim_chip(c) }}{% if c.page_print %} <span class="muted">(печ. {{ c.page_print }})</span>{% endif %} {{ c.text }}</li>
  {% endfor %}
  </ol>
  {% endcall %}
</section>

</section>
{% endif %}
</div><!--/step-body-->

<footer class="step-foot">
  <nav class="pager" aria-label="Соседние шаги">
    {% if prev %}<a rel="prev" href="step-{{ prev.id }}.html">{{ icon("arrow-left") }}<span><small>Назад</small>{{ titles[prev.id] }}</span></a>{% else %}<a href="index.html">{{ icon("arrow-left") }}<span>К пути</span></a>{% endif %}
    {% if next %}<a rel="next" href="step-{{ next.id }}.html"><span><small>Дальше</small>{{ titles[next.id] }}</span>{{ icon("arrow-right") }}</a>{% else %}<a href="cards.html"><span>К карточкам</span>{{ icon("arrow-right") }}</a>{% endif %}
  </nav>
</footer>
</article>
<aside class="step-aside" aria-label="Источник и прогресс шага">
  <div class="side-card">
    <h2>{{ icon("book-open") }}Источник</h2>
    <p class="side-pages">{{ v.pages_label or "Страницы не указаны" }}</p>
    {% if n.claims %}<button type="button" class="pg pg-btn" data-claim="{{ (v.text_claims[0] if v.text_claims else n.claims[0]).id }}">{{ icon("magnifying-glass") }}Открыть страницу книги</button>{% endif %}
    <label class="switch"><input type="checkbox" role="switch" id="toggle-by" data-by-switch><span class="switch-track" aria-hidden="true"></span><span class="switch-text">Показать, что из книги, а что пересказ</span></label>
    {% if v.tasks %}
    <div class="side-progress">
      <div class="bar slim"><span id="step-bar-side"></span></div>
      <p id="step-progress-side" class="muted" data-side-progress>Задания: 0 из {{ v.tasks | length }}</p>
    </div>
    {% endif %}
  </div>
</aside>
<script type="application/json" id="step-data">{{ v.data_json }}</script>
{% if v.has_terms %}<script type="application/json" id="term-data">{{ v.terms_json }}</script>{% endif %}
{% if v.tasks %}<script type="application/json" id="tasks-data">{{ v.tasks_json }}</script>{% endif %}
{% endblock %}

{% block after_main %}
<div class="step-bar" role="group" aria-label="Навигация по шагам">
  <button type="button" class="bar-btn" data-open-menu aria-haspopup="dialog" aria-controls="menu">{{ icon("list") }}<span>Меню</span></button>
  {% if prev %}<a class="bar-btn" href="step-{{ prev.id }}.html">{{ icon("arrow-left") }}<span>Назад</span></a>{% else %}<a class="bar-btn" href="index.html">{{ icon("arrow-left") }}<span>Назад</span></a>{% endif %}
  {% if next %}<a class="bar-btn primary" href="step-{{ next.id }}.html"><span>Далее</span>{{ icon("arrow-right") }}</a>{% else %}<a class="bar-btn primary" href="cards.html"><span>Далее</span>{{ icon("arrow-right") }}</a>{% endif %}
</div>


<dialog id="book" aria-labelledby="book-h">
  <form method="dialog" class="dlg-close"><button type="submit" class="tool" aria-label="Закрыть">{{ icon("x") }}</button></form>
  <h2 id="book-h">Страница книги</h2>
  <div id="book-body"></div>
</dialog>
{% endblock %}
