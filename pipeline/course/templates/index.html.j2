{% extends "base.html.j2" %}
{% block main %}
{% set part_names = parts | map(attribute=0) | unique | list %}
<section class="cover hero">
  <h1>{{ chapter_title }}</h1>
  <p class="lead">Курс по главе книги для тех, кто работает с данными: {{ steps | length }} {{ steps | length | plural("короткий шаг", "коротких шага", "коротких шагов") }}, ≈ {{ total_minutes }} {{ total_minutes | plural("минута", "минуты", "минут") }}{% if n_tasks %}, {{ n_tasks }} {{ n_tasks | plural("задание", "задания", "заданий") }}{% endif %}. Каждое утверждение можно проверить по странице книги.</p>

  <a id="resume" class="resume-card" href="step-{{ steps[0].id }}.html">
    <span class="ring" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="64" height="64"><circle class="ring-bg" cx="32" cy="32" r="28"/><circle class="ring-fg" id="ring-fg" cx="32" cy="32" r="28" transform="rotate(-90 32 32)"/></svg>
      <span class="ring-play">{{ icon("play") }}</span>
    </span>
    <span class="resume-text">
      <span class="resume-label" id="resume-label">Начать</span>
      <span class="resume-title" id="resume-title">{{ steps[0].title }}</span>
      <span class="resume-sub" id="progress-text" aria-live="polite" hidden>Пройдено 0 из {{ steps | length }}</span>
    </span>
    <span class="sr">Открыть шаг</span>
  </a>
</section>

<div class="index-controls">
  {% if part_names | length > 1 %}
  <div class="part-tabs" role="group" aria-label="Части главы">
    <button type="button" data-part="" aria-pressed="true">Все части</button>
    {% for pn in part_names %}<button type="button" data-part="{{ pn }}" aria-pressed="false">{{ pn }}</button>{% endfor %}
  </div>
  {% endif %}
  <div class="segment" role="group" aria-label="Какие шаги показывать" hidden>
    <button type="button" data-seg="all" aria-pressed="true">Все</button>
    <button type="button" data-seg="repeat" aria-pressed="false">Повторить</button>
  </div>
</div>

<nav class="path" aria-label="Путь по главе">
{% set ns = namespace(i=0) %}
{% for part, nodes in parts %}
  <section class="part" data-part="{{ part }}">
    {% if part_names | length > 1 %}<h2>{{ part }}</h2>{% endif %}
    <ol class="steps-list timeline">
    {% for n in nodes %}
      {% set s = steps[ns.i] %}
      {% set ns.i = ns.i + 1 %}
      <li data-node="{{ n.id }}">
        <a href="step-{{ n.id }}.html" class="step-row">
          <span class="num">{{ ns.i }}</span>
          <span class="row-main">
            <span class="st-title">{{ s.title }}</span>
            <span class="st-meta">≈ {{ s.minutes }} мин{% if s.tasks %} · {{ s.tasks }} {{ s.tasks | plural("задание", "задания", "заданий") }}{% endif %}{% if s.illus %} · {{ s.illus }} {{ s.illus | plural("иллюстрация", "иллюстрации", "иллюстраций") }}{% endif %}{% if s.video %} · {{ icon("video-camera") }}ролик{% endif %}</span>
          </span>
          <span class="row-end">
            {% if s.tasks %}<span class="badge" data-badge="{{ n.id }}" data-total="{{ s.tasks }}" hidden>решено 0/{{ s.tasks }}</span>{% endif %}
            <span class="done-mark">{{ icon("check-circle") }}<span class="sr">пройден</span></span>
          </span>
        </a>
      </li>
    {% endfor %}
    </ol>
  </section>
{% endfor %}
  <p id="steps-empty" class="empty" hidden>Здесь пока ничего нет: отметь шаги «повторить» в карточках или реши задания с ошибками.</p>
</nav>

<section class="materials" aria-labelledby="materials-h">
  <h2 id="materials-h">Материалы главы</h2>
  <ul class="tiles">
    {% if has_glossary %}<li><a href="glossary.html">{{ icon("book-bookmark") }}<span class="tile-t">Словарь главы</span><span class="tile-d">Термины с определениями и страницей книги</span></a></li>{% endif %}
    {% if has_it %}<li><a href="it.html">{{ icon("cpu") }}<span class="tile-t">Что ломается в данных</span><span class="tile-d">Что значит каждый шаг для данных и где они ломаются</span></a></li>{% endif %}
    <li><a href="summary.html">{{ icon("article") }}<span class="tile-t">Конспект</span><span class="tile-d">Главное по шагам, печать в PDF</span></a></li>
    <li><a href="map.html">{{ icon("tree-structure") }}<span class="tile-t">Карта связей</span><span class="tile-d">Какой шаг на каком держится</span></a></li>
    <li><a href="{% if n_tasks %}progress.html{% else %}cards.html{% endif %}">{{ icon("arrow-counter-clockwise") }}<span class="tile-t">Повторение</span><span class="tile-d">{% if n_tasks %}Прогресс, ошибки и карточки{% else %}Карточки «знаю / повторить»{% endif %}</span></a></li>
    {% if n_tasks %}<li><a href="tasks.html">{{ icon("list-checks") }}<span class="tile-t">Все задания</span><span class="tile-d">{{ n_tasks }} {{ n_tasks | plural("задание", "задания", "заданий") }} по шагам с разбором</span></a></li>{% endif %}
    {% if has_errata %}<li><a href="errata.html">{{ icon("warning") }}<span class="tile-t">Лист опечаток</span><span class="tile-d">Что исправлено в распознанном тексте</span></a></li>{% endif %}
  </ul>
</section>
{% endblock %}
