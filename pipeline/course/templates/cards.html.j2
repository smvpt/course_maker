{% extends "base.html.j2" %}
{% from "_macros.html.j2" import review_tabs %}
{% block title %}Карточки — {{ chapter_title }}{% endblock %}
{% block main %}
<h1>Карточки повторения</h1>
{{ review_tabs("cards") }}
<p class="muted">Вспомни суть шага, открой карточку и отметь: знаю или повторить.</p>
<p class="filter"><label><input type="checkbox" id="only-repeat"> Только «повторить»</label></p>
<ol class="cards">
{% for n in nodes %}
  <li class="card" data-node="{{ n.id }}">
    <details>
      <summary><span class="num">{{ loop.index }}</span><span class="card-title">{{ n.title_novice or n.title }}</span><span class="reveal"><span class="when-closed">Показать суть</span><span class="when-open">Скрыть</span>{{ icon("caret-down") }}</span></summary>
      <div class="card-back">
        <p data-by="{{ by_of(n.layers.main) }}">{{ n.layers.main.text }}</p>
        <p><a href="step-{{ n.id }}.html">Открыть шаг</a></p>
      </div>
    </details>
    <div class="card-btns" role="group" aria-label="Оценка">
      <button type="button" class="btn-small" data-mark="know" aria-pressed="false">{{ icon("check") }}<span>Знаю</span></button>
      <button type="button" class="btn-small" data-mark="repeat" aria-pressed="false">{{ icon("arrow-counter-clockwise") }}<span>Повторить</span></button>
    </div>
  </li>
{% endfor %}
</ol>
<p class="fine">Отметки хранятся только в этом браузере.</p>
{% endblock %}
