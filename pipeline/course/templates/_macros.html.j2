{# Общие куски: список шагов пути (боковая панель, шторка, обложка) и метка «автор / модель / гипотеза». #}
{% macro badge(by) -%}
<span class="by by-{{ by }}">{{ {"author": "автор", "model": "модель", "hypothesis": "гипотеза"}[by] }}</span>
{%- endmacro %}

{% macro path_list(steps, current=None) -%}
<ol class="path-list">
{% for s in steps %}
  <li data-node="{{ s.id }}"{% if s.id == current %} class="current"{% endif %}>
    <a href="step-{{ s.id }}.html"{% if s.id == current %} aria-current="step"{% endif %}>
      <span class="num">{{ loop.index }}</span>
      <span class="st-title">{{ s.title }}</span>
      <span class="done-mark">{{ icon("check-circle") }}<span class="sr">пройден</span></span>
    </a>
  </li>
{% endfor %}
</ol>
{%- endmacro %}

{# Общая полоса вкладок раздела «Повторение»: Прогресс · Ошибки · Карточки #}
{% macro review_tabs(page) -%}
<nav class="review-tabs" aria-label="Повторение">
  {% for key, href, text, ic in (("progress", "progress.html", "Прогресс", "chart-bar"), ("mistakes", "mistakes.html", "Ошибки", "arrow-counter-clockwise"), ("cards", "cards.html", "Карточки", "cards")) %}
  <a href="{{ href }}"{% if page == key %} aria-current="page"{% endif %}>{{ icon(ic) }}<span>{{ text }}</span></a>
  {% endfor %}
</nav>
{%- endmacro %}
